# Procurement Advisor Agent - Environment Variables
# Copy this file to .env and fill in your values

# ── Gemini ──────────────────────────────────────────────────────────────────
# Get your API key from https://ai.google.dev/
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-pro

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///procurement_db.db
SQL_ECHO=false

# ── Auth ─────────────────────────────────────────────────────────────────────
# Change JWT_SECRET to any long random string before deploying
JWT_SECRET=dev-secret-change-in-production
# Set to true to enforce JWT on every route (leave false for local dev)
REQUIRE_AUTH=false
# Expire access tokens after N minutes (default 1440 = 24 h)
JWT_EXPIRE_MINUTES=1440

# ── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
